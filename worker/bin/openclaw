#!/usr/bin/env bash
# shellcheck disable=SC2016
set -Eeuo pipefail

readonly UPSTREAM_OPENCLAW="/usr/local/bin/openclaw"
readonly PLUGIN_ID="tiangong-control"
readonly PLUGIN_PATH="/opt/tiangong-worker/plugin"
readonly PREFLIGHT="/opt/tiangong-worker/scripts/openclaw-preflight.mjs"
readonly RUNTIME_ROUTE_PREFLIGHT="/opt/tiangong-worker/scripts/runtime-route-preflight.mjs"
readonly AGENT_PACKAGE_LOADER="/opt/tiangong-worker/agent/packages/loader.mjs"
readonly TOOL_ALLOWLIST_RESOLVER="/opt/tiangong-worker/scripts/resolve-openclaw-tool-allowlist.mjs"

assert_member_runtime_route() {
  [[ "${TIANGONG_MEMBER_RUNTIME_ROUTING_REQUIRED:-0}" == "1" ]] || return 0
  export OPENCLAW_AGENT_RUNTIME="pi"
  TIANGONG_SELECTED_MODEL="${TIANGONG_SELECTED_MODEL:-${AGENTTEAMS_MODEL:-}}" \
  OPENCLAW_AGENT_HARNESS_FALLBACK="${OPENCLAW_AGENT_HARNESS_FALLBACK:-none}" \
  /usr/bin/node --input-type=module -e '
    const { runtimeRouteFromEnvironment } = await import(process.argv[1]);
    const { resolveAgentRuntimeFromEnvironment } = await import(process.argv[2]);
    const route = runtimeRouteFromEnvironment(process.env);
    const agent = await resolveAgentRuntimeFromEnvironment(process.env);
    console.error(`tiangong_runtime_route=pass responsibility=${route.responsibility} runtime=${route.runtime} model=${route.model} fallback=${route.fallback} digest=${route.routeDigest} agentPackage=${agent.agentPackage.packageId}@${agent.agentPackage.version} effectiveSkills=${agent.effectiveSkills.length}`);
  ' "${RUNTIME_ROUTE_PREFLIGHT%/*}/../agent/runtime-routing.mjs" "${AGENT_PACKAGE_LOADER}"
}

load_agentteams_controller_token() {
  local token_file="${AGENTTEAMS_AUTH_TOKEN_FILE:-}"
  [[ -z "${AGENTTEAMS_AUTH_TOKEN:-}" ]] || return 0
  [[ -z "${token_file}" ]] && return 0
  [[ -r "${token_file}" ]] || { printf '[tiangong-worker] ERROR: AgentTeams controller token file is not readable.\n' >&2; return 1; }
  AGENTTEAMS_AUTH_TOKEN="$(<"${token_file}")"
  [[ -n "${AGENTTEAMS_AUTH_TOKEN}" ]] || { printf '[tiangong-worker] ERROR: AgentTeams controller token file is empty.\n' >&2; return 1; }
  export AGENTTEAMS_AUTH_TOKEN
}

update_config() {
  local suffix="$1" filter="$2" config_file temporary_file
  config_file="${OPENCLAW_CONFIG_PATH:-${HOME}/openclaw.json}"
  [[ -f "${config_file}" ]] || { printf '[tiangong-worker] ERROR: OpenClaw config not found: %s\n' "${config_file}" >&2; return 1; }
  temporary_file="$(mktemp "${config_file}.${suffix}.XXXXXX")"
  trap 'rm -f "${temporary_file:-}"' RETURN
  jq "${filter}" "${config_file}" >"${temporary_file}"
  chmod 600 "${temporary_file}"
  mv "${temporary_file}" "${config_file}"
  trap - RETURN
}

configure_builtin_gateway() {
  local gateway_url gateway_base_url provider_id
  gateway_url="${AGENTTEAMS_AI_GATEWAY_URL:-}"
  [[ -n "${gateway_url}" ]] || return 0
  [[ "${gateway_url}" =~ ^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?$ ]] || { printf '[tiangong-worker] ERROR: AgentTeams gateway URL is invalid.\n' >&2; return 1; }
  gateway_base_url="${gateway_url%/}/v1"
  provider_id="agentteams-gateway"
  TIANGONG_PROVIDER_ID="${provider_id}" TIANGONG_GATEWAY_BASE_URL="${gateway_base_url}" update_config tiangong-gateway '
    env.TIANGONG_PROVIDER_ID as $provider
    | env.TIANGONG_GATEWAY_BASE_URL as $base_url
    | if (.models.providers[$provider] | type) == "object"
      then .models.providers[$provider].baseUrl = $base_url
      else error("AgentTeams gateway provider is missing") end
  '
  printf '[tiangong-worker] builtin_gateway_override=pass provider=%s\n' "${provider_id}" >&2
}

configure_workspace_boundary() {
  local tool_allowlist
  if [[ "${TIANGONG_MEMBER_RUNTIME_ROUTING_REQUIRED:-0}" == "1" ]]; then tool_allowlist="$(/usr/bin/node "${TOOL_ALLOWLIST_RESOLVER}")"; else tool_allowlist='[]'; fi
  TIANGONG_TOOL_ALLOWLIST="${tool_allowlist}" update_config tiangong-workspace '
    env.TIANGONG_TOOL_ALLOWLIST | fromjson as $allow
    | .tools = (.tools // {})
    | .tools.fs = ((.tools.fs // {}) + {workspaceOnly: true})
    | .tools.allow = $allow
  '
}

configure_tiangong_plugin() {
  TIANGONG_PLUGIN_ID="${PLUGIN_ID}" TIANGONG_PLUGIN_PATH="${PLUGIN_PATH}" update_config tiangong-plugin '
    env.TIANGONG_PLUGIN_ID as $id | env.TIANGONG_PLUGIN_PATH as $path
    | .plugins = (.plugins // {})
    | .plugins.load = (.plugins.load // {})
    | .plugins.load.paths = ([((.plugins.load.paths // [])[]), $path] | unique)
    | .plugins.entries = (.plugins.entries // {})
    | .plugins.entries[$id] = ((.plugins.entries[$id] // {}) + {enabled: true})
    | .plugins.allow = if (.plugins.allow | type) == "array" then ([.plugins.allow[], $id] | unique) else [$id] end
  '
}

if [[ "${1:-}" == "gateway" && "${2:-}" == "run" ]]; then
  load_agentteams_controller_token
  assert_member_runtime_route
  configure_tiangong_plugin
  configure_workspace_boundary
  configure_builtin_gateway
  /usr/bin/node "${PREFLIGHT}"
  printf '[tiangong-worker] Starting upstream OpenClaw built-in runtime (pinned id pi).\n' >&2
fi

exec "${UPSTREAM_OPENCLAW}" "$@"
