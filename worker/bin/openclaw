#!/usr/bin/env bash
set -Eeuo pipefail

readonly UPSTREAM_OPENCLAW="/usr/local/bin/openclaw"
readonly PLUGIN_ID="tiangong-pi"
readonly PLUGIN_PATH="/opt/tiangong-worker/plugin"
readonly PREFLIGHT="/opt/tiangong-worker/scripts/openclaw-preflight.mjs"
readonly CODEX_GATEWAY_PREFLIGHT="/opt/tiangong-worker/agent/preflight/codex-gateway-preflight.mjs"
readonly CODEX_CAPABILITY_DETECTOR="/opt/tiangong-worker/agent/preflight/codex-capability-detection.mjs"
readonly CODEX_CAPABILITY_CACHE="/opt/tiangong-worker/agent/preflight/codex-capability-cache.mjs"
codex_home=""

cleanup_codex_home() {
  [[ -n "${codex_home}" ]] || return 0
  rm -rf -- "${codex_home}"
  codex_home=""
}

configure_codex_gateway() {
  local config_file provider_base_url provider_api_key provider_id model_id provider_toml_id temporary_file base_url_override credential_source bridge_mode provider_http_headers sidecar_receipt_path transport_mode cache_path cache_result resolved_transport resolved_bridge resolved_base_url cache_hit
  [[ "${TIANGONG_RUNTIME_LANE:-legacy-v0.2}" == "openclaw-canary" ]] || return 0
  [[ "${TIANGONG_CODEX_RUNTIME:-0}" == "1" ]] || return 0
  config_file="${OPENCLAW_CONFIG_PATH:-${HOME}/openclaw.json}"
  [[ -f "${config_file}" ]] || {
    printf '[tiangong-worker] ERROR: OpenClaw config not found: %s\n' "${config_file}" >&2
    return 1
  }
  provider_id="${TIANGONG_CODEX_PROVIDER:-agentteams-gateway}"
  model_id="${TIANGONG_CODEX_MODEL:-deepseek-v4-pro}"
  transport_mode="${TIANGONG_CODEX_TRANSPORT:-auto}"
  bridge_mode="${TIANGONG_CODEX_BRIDGE:-auto}"
  credential_source="${TIANGONG_CODEX_CREDENTIAL_SOURCE:-agentteams-consumer-token}"
  [[ "${credential_source}" == "agentteams-consumer-token" ]] || {
    printf '[tiangong-worker] ERROR: unsupported Codex credential source: %s\n' "${credential_source}" >&2
    return 1
  }
  [[ "${provider_id}" =~ ^[A-Za-z0-9_-]+$ ]] || {
    printf '[tiangong-worker] ERROR: unsafe Codex provider id: %s\n' "${provider_id}" >&2
    return 1
  }
  provider_api_key="$(jq -er --arg provider "${provider_id}" '.models.providers[$provider].apiKey // empty' "${config_file}" || true)"
  provider_api_key="${provider_api_key:-${AGENTTEAMS_WORKER_GATEWAY_KEY:-}}"
  [[ -n "${provider_api_key}" ]] || {
    printf '[tiangong-worker] ERROR: AgentTeams Worker consumer token is unavailable.\n' >&2
    return 1
  }
  base_url_override="${TIANGONG_CODEX_BASE_URL:-}"
  sidecar_receipt_path="${TIANGONG_CODEX_SIDECAR_RECEIPT_PATH:-}"
  if [[ -n "${base_url_override}" ]]; then
    provider_base_url="${base_url_override}"
  else
    provider_base_url="$(jq -er --arg provider "${provider_id}" '.models.providers[$provider].baseUrl' "${config_file}")"
  fi
  if [[ "${transport_mode}" == "auto" || "${bridge_mode}" == "auto" ]]; then
    cache_path="${TIANGONG_CODEX_CAPABILITY_CACHE_PATH:-/var/lib/tiangong-capabilities/codex.json}"
    cache_result="$(
      TIANGONG_CODEX_CACHE_PROVIDER="${provider_id}" \
      TIANGONG_CODEX_CACHE_MODEL="${model_id}" \
      TIANGONG_CODEX_CACHE_BASE_URL="${provider_base_url}" \
      TIANGONG_CODEX_CACHE_TOKEN="${provider_api_key}" \
      TIANGONG_CODEX_CACHE_RECEIPT_PATH="${sidecar_receipt_path}" \
      TIANGONG_CODEX_CACHE_PATH="${cache_path}" \
      /usr/bin/node --input-type=module -e '
        const { CODEX_DETECTOR_VERSION, detectCodexRoute, readOpenCodexSidecarReceipt } = await import(process.argv[1]);
        const { createCodexCapabilityCache } = await import(process.argv[2]);
        const provider = process.env.TIANGONG_CODEX_CACHE_PROVIDER;
        const model = process.env.TIANGONG_CODEX_CACHE_MODEL;
        const baseUrl = process.env.TIANGONG_CODEX_CACHE_BASE_URL;
        const cache = createCodexCapabilityCache({ path: process.env.TIANGONG_CODEX_CACHE_PATH });
        const resolved = await cache.resolve({
          provider,
          model,
          baseUrl,
          detectorVersion: CODEX_DETECTOR_VERSION,
          probe: (fingerprint) => detectCodexRoute({
            provider,
            model,
            baseUrl: fingerprint.baseUrl,
            consumerToken: process.env.TIANGONG_CODEX_CACHE_TOKEN,
            requireBridgeReceipt: false,
          }),
        });
        let endpoint = resolved.record.baseUrl;
        if (resolved.record.transport === "responses-via-chat-bridge") {
          const receipt = await readOpenCodexSidecarReceipt(process.env.TIANGONG_CODEX_CACHE_RECEIPT_PATH || undefined, { provider, model });
          endpoint = receipt.endpoint;
        }
        console.log(JSON.stringify({ endpoint, transport: resolved.record.transport, bridge: resolved.record.transport === "responses-via-chat-bridge" ? "opencodex" : null, cacheHit: resolved.cacheHit, outcome: resolved.record.outcome, reasonCode: resolved.record.reasonCode }));
      ' "${CODEX_CAPABILITY_DETECTOR}" "${CODEX_CAPABILITY_CACHE}"
    )"
    resolved_transport="$(jq -er '.transport' <<<"${cache_result}")"
    resolved_bridge="$(jq -r '.bridge // "none"' <<<"${cache_result}")"
    resolved_base_url="$(jq -er '.endpoint' <<<"${cache_result}")"
    cache_hit="$(jq -r '.cacheHit' <<<"${cache_result}")"
    transport_mode="${resolved_transport}"
    bridge_mode="${resolved_bridge}"
    provider_base_url="${resolved_base_url}"
    base_url_override="${resolved_base_url}"
    printf '[tiangong-worker] codex_capability_cache=pass hit=%s route=%s bridge=%s path=%s\n' "${cache_hit}" "${transport_mode}" "${bridge_mode}" "${cache_path}" >&2
  fi
  export TIANGONG_CODEX_TRANSPORT="${transport_mode}"
  export TIANGONG_CODEX_BRIDGE="${bridge_mode}"
  TIANGONG_PREFLIGHT_CONSUMER_TOKEN="${provider_api_key}" \
  TIANGONG_PREFLIGHT_BASE_URL="${base_url_override}" \
  TIANGONG_PREFLIGHT_SIDECAR_RECEIPT_PATH="${sidecar_receipt_path}" \
  TIANGONG_CODEX_TRANSPORT="${transport_mode}" \
  TIANGONG_CODEX_BRIDGE="${bridge_mode}" \
  /usr/bin/node --input-type=module -e '
    const { runCodexGatewayPreflightFromFile } = await import(process.argv[1]);
    const result = await runCodexGatewayPreflightFromFile({
      configPath: process.argv[2],
      consumerToken: process.env.TIANGONG_PREFLIGHT_CONSUMER_TOKEN,
      baseUrlOverride: process.env.TIANGONG_PREFLIGHT_BASE_URL || undefined,
      sidecarReceiptPath: process.env.TIANGONG_PREFLIGHT_SIDECAR_RECEIPT_PATH || undefined,
    });
    console.log(`codex_gateway_preflight=pass provider=${result.provider} model=${result.model} gateway_probe=${result.gatewayProbe} gateway_probe_contract=${result.gatewayProbeContract} transport=${result.transport} bridge=${result.bridge ?? "none"} credential_source=${result.credentialSource} sidecar=${result.sidecarReadiness ?? "none"} sidecar_id=${result.sidecarId ?? "none"} sidecar_generation=${result.sidecarGeneration ?? "none"}`);
  ' "${CODEX_GATEWAY_PREFLIGHT}" "${config_file}"
  temporary_file="$(mktemp "${config_file}.tiangong-codex-credential.XXXXXX")"
  trap 'rm -f "${temporary_file:-}"' RETURN
  jq --arg provider "${provider_id}" --arg base_url "${base_url_override}" '
    if (.models.providers[$provider] | type) == "object"
    then (if $base_url != "" then .models.providers[$provider].baseUrl = $base_url else . end)
      | del(.models.providers[$provider].apiKey)
    else .
    end
  ' "${config_file}" >"${temporary_file}"
  chmod 600 "${temporary_file}"
  mv "${temporary_file}" "${config_file}"
  trap - RETURN
  unset DEEPSEEK_API_KEY DEEPSEEK_BASE_URL CODEX_API_KEY OPENAI_BASE_URL
  codex_home="$(mktemp -d "${TMPDIR:-/tmp}/tiangong-codex-home.XXXXXX")"
  chmod 700 "${codex_home}"
  provider_toml_id="$(printf '%s' "${provider_id}" | jq -Rsa .)"
  provider_http_headers=""
  if [[ "${bridge_mode}" == "opencodex" ]]; then
    # OpenCodex deliberately requires its dedicated admission header on Responses/Chat routes;
    # the value is still the scoped AgentTeams consumer token, never an upstream provider key.
    provider_http_headers=$'env_http_headers = { "x-opencodex-api-key" = "OPENAI_API_KEY" }\n'
  fi
  printf 'model_provider = %s\n\n[model_providers.%s]\nname = %s\nbase_url = %s\nenv_key = "OPENAI_API_KEY"\nwire_api = "responses"\n%s\nsupports_websockets = false\n\n[features]\nresponses_websockets = false\nresponses_websockets_v2 = false\n' \
    "${provider_toml_id}" "${provider_id}" "${provider_toml_id}" "$(printf '%s' "${provider_base_url}" | jq -Rsa .)" "${provider_http_headers}" >"${codex_home}/config.toml"
  chmod 600 "${codex_home}/config.toml"
  export CODEX_HOME="${codex_home}"
  # This is the scoped AgentTeams consumer token. The upstream provider key stays behind the gateway/bridge.
  export OPENAI_API_KEY="${provider_api_key}"
  export OPENCLAW_CODEX_APP_SERVER_BIN="/opt/tiangong-worker/bin/codex-app-server"
  trap cleanup_codex_home EXIT INT TERM
}

configure_codex_runtime() {
  local config_file temporary_file model_id model_ref model_alias
  [[ "${TIANGONG_RUNTIME_LANE:-legacy-v0.2}" == "openclaw-canary" ]] || return 0
  [[ "${TIANGONG_CODEX_RUNTIME:-0}" == "1" ]] || return 0
  config_file="${OPENCLAW_CONFIG_PATH:-${HOME}/openclaw.json}"
  [[ -f "${config_file}" ]] || {
    printf '[tiangong-worker] ERROR: OpenClaw config not found: %s\n' "${config_file}" >&2
    return 1
  }
  temporary_file="$(mktemp "${config_file}.tiangong-codex.XXXXXX")"
  trap 'rm -f "${temporary_file:-}"' RETURN
  model_id="${TIANGONG_CODEX_MODEL:-deepseek-v4-pro}"
  model_ref="codex/${model_id}"
  model_alias="${TIANGONG_CODEX_MODEL_ALIAS:-${model_id}}"
  jq --arg model_ref "${model_ref}" --arg model_alias "${model_alias}" '
    .plugins = (.plugins // {})
    | .plugins.entries = (.plugins.entries // {})
    | .plugins.entries.codex = ((.plugins.entries.codex // {}) + {enabled: true})
    | .plugins.entries.codex.config = ((.plugins.entries.codex.config // {}) + {
        appServer: ((.plugins.entries.codex.config.appServer // {}) + {
          transport: "stdio",
          command: "/opt/tiangong-worker/bin/codex-app-server"
        })
      })
    | .plugins.allow = if (.plugins.allow | type) == "array"
        then ([.plugins.allow[], "codex"] | unique)
        else .plugins.allow end
    | .agents = (.agents // {})
    | .agents.defaults = (.agents.defaults // {})
    | .agents.defaults.model = {primary: $model_ref, fallbacks: []}
    | .agents.defaults.models = (.agents.defaults.models // {})
    | .agents.defaults.models[$model_ref] = ((.agents.defaults.models[$model_ref] // {}) + {alias: $model_alias})
    | .agents.defaults.embeddedHarness = {runtime: "codex", fallback: "none"}
  ' "${config_file}" >"${temporary_file}"
  chmod 600 "${temporary_file}"
  mv "${temporary_file}" "${config_file}"
  trap - RETURN
}

configure_tiangong_plugin() {
  local config_file temporary_file runtime_lane
  config_file="${OPENCLAW_CONFIG_PATH:-${HOME}/openclaw.json}"
  [[ -f "${config_file}" ]] || {
    printf '[tiangong-worker] ERROR: OpenClaw config not found: %s\n' "${config_file}" >&2
    return 1
  }

  temporary_file="$(mktemp "${config_file}.tiangong.XXXXXX")"
  trap 'rm -f "${temporary_file:-}"' RETURN
  runtime_lane="${TIANGONG_RUNTIME_LANE:-legacy-v0.2}"
  [[ "${runtime_lane}" == "legacy-v0.2" || "${runtime_lane}" == "openclaw-canary" ]] || {
    printf '[tiangong-worker] ERROR: unsupported runtime lane: %s\n' "${runtime_lane}" >&2
    return 1
  }
  jq --arg plugin_id "${PLUGIN_ID}" --arg plugin_path "${PLUGIN_PATH}" \
    --arg runtime_lane "${runtime_lane}" '
    .plugins = (.plugins // {})
    | .plugins.load = (.plugins.load // {})
    | .plugins.load.paths = ([((.plugins.load.paths // [])[]), $plugin_path] | unique)
    | .plugins.entries = (.plugins.entries // {})
    | .plugins.entries[$plugin_id] = ((.plugins.entries[$plugin_id] // {}) + {
        enabled: true,
        config: ((.plugins.entries[$plugin_id].config // {}) + {runtimeLane: $runtime_lane})
      })
    | .plugins.allow = if (.plugins.allow | type) == "array"
        then ([.plugins.allow[], $plugin_id] | unique)
        else [$plugin_id]
      end
  ' "${config_file}" >"${temporary_file}"
  chmod 600 "${temporary_file}"
  mv "${temporary_file}" "${config_file}"
  trap - RETURN
}

if [[ "${1:-}" == "gateway" && "${2:-}" == "run" ]]; then
  configure_tiangong_plugin
  configure_codex_runtime
  configure_codex_gateway
  /usr/bin/node "${PREFLIGHT}"
  if [[ "${TIANGONG_CODEX_RUNTIME:-0}" == "1" && "${TIANGONG_RUNTIME_LANE:-legacy-v0.2}" == "openclaw-canary" ]]; then
    printf '[tiangong-worker] Starting upstream OpenClaw with the native Codex harness.\n' >&2
    "${UPSTREAM_OPENCLAW}" "$@"
    status=$?
    cleanup_codex_home
    exit "${status}"
  else
    printf '[tiangong-worker] Starting upstream OpenClaw with the Tiangong pi harness.\n' >&2
  fi
fi

exec "${UPSTREAM_OPENCLAW}" "$@"
