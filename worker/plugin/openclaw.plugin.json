{
  "id": "tiangong-control",
  "name": "Tiangong control plugin",
  "description": "Registers Tiangong's fail-closed OpenClaw tools and coordination hooks.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "observability": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enabled"],
        "properties": {
          "enabled": { "type": "boolean" },
          "endpoint": { "type": "string", "maxLength": 2048 }
        }
      }
    }
  }
}
