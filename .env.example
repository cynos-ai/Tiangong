# Tiangong local AgentTeams configuration
# Copy with `make init`, then provide the required secret.
# Syntax is strict KEY=VALUE dotenv; shell expressions are not executed.

# Pinned upstream runtime. The bootstrap rejects other versions.
AGENTTEAMS_VERSION=v1.2.2
AGENTTEAMS_LANGUAGE=zh

# LLM provider. Any OpenAI-compatible endpoint can replace these defaults.
AGENTTEAMS_LLM_PROVIDER=openai-compat
AGENTTEAMS_OPENAI_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
# Internal AgentTeams/Higress route projected into local Docker Workers.
# The bootstrap derives the official AGENTTEAMS_AI_GATEWAY_DOMAIN installer
# field from this URL.
AGENTTEAMS_AI_GATEWAY_URL=http://aigw-local.agentteams.io:8080
AGENTTEAMS_DEFAULT_MODEL=glm-5
AGENTTEAMS_LLM_API_KEY=

# Read-only route check (does not start or restart containers):
#   make provider-check
# Known profiles are Qwen native, DeepSeek Responses, and Qwen Coding Plan
# through the OpenCodex Chat/Completions bridge. The check never prints the key.

# Bootstrap administrator. Leave the password empty to generate it locally.
AGENTTEAMS_ADMIN_USER=admin
AGENTTEAMS_ADMIN_PASSWORD=

# Local ports. The bootstrap always binds them to 127.0.0.1.
AGENTTEAMS_PORT_GATEWAY=18080
AGENTTEAMS_PORT_CONSOLE=18001
AGENTTEAMS_PORT_ELEMENT_WEB=18088
AGENTTEAMS_PORT_MANAGER_CONSOLE=18888
AGENTTEAMS_PORT_DASHBOARD=13000

# New Teams use the AgentTeams OpenClaw Worker runtime by default. Existing
# legacy Teams are not rewritten by this setting; their Tiangong pi lane stays
# available as an explicit deployment rollback until migration gates pass.
AGENTTEAMS_MANAGER_RUNTIME=copaw
AGENTTEAMS_DEFAULT_WORKER_RUNTIME=openclaw
AGENTTEAMS_MATRIX_E2EE=0
AGENTTEAMS_WORKER_IDLE_TIMEOUT=720

# Upstream AgentTeams management dashboard.
AGENTTEAMS_DASHBOARD=1
# Optional overrides; leave unset to use the installer defaults.
# AGENTTEAMS_DASHBOARD_VERSION=
# AGENTTEAMS_DASHBOARD_IMAGE=

# Optional Coordination runtime (copy these templates into a separate owner-only
# coordination.env; keep them commented here because `make up` parses only the
# AgentTeams keys above). Host-side selectors are exported in the shell, not
# placed in coordination.env:
# TIANGONG_LEADER_RUNTIME_BINDING_FILE=/absolute/path/to/leader-binding.json
# TIANGONG_COORDINATION_ENV_FILE=/absolute/path/to/coordination.env
# TIANGONG_COORDINATION_HOST_PORT=18780
# Minimum coordination.env contents:
# TIANGONG_COORDINATION_DATABASE_URL=postgres://user:password@postgres:5432/tiangong
# TIANGONG_COORDINATION_CONTROL_TOKEN=generate-a-random-deployment-token
# Add these two lines for the loopback HTTP Matrix workbench:
# AGENTTEAMS_MATRIX_URL=http://agentteams-controller:6167
# TIANGONG_WEB_SECURE_COOKIES=0
# Optional; enables only the deployment-owned Matrix wake-outbox sender:
# TIANGONG_COORDINATION_MATRIX_TOKEN=deployment-scoped-matrix-token

# AgentLoop diagnostics are configured outside this dotenv because the write
# credential belongs only to the separate Collector. See docs/observability.md.
# Export these only for an owned disposable integration run:
# TIANGONG_AGENTLOOP_SECRET_FILE=/absolute/repository-external/agentloop.env
# TIANGONG_AGENTLOOP_ENABLED=1
# TIANGONG_AGENTLOOP_CONTENT_CAPTURE=isolated-test
# TIANGONG_AGENTLOOP_SERVICE_NAME=tiangong-m8-test
# TIANGONG_AGENTLOOP_CONSOLE_URL=https://agentloop4service.console.aliyun.com/agentloop/region/<region>/agentspace/<workspace>/app/llm_agent/app-list

# Generated paths, the Docker volume name, socket mounting, and network exposure
# are intentionally fixed by scripts/agentteams.sh and are not configurable.
