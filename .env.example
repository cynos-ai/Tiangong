# Tiangong local AgentTeams configuration
# Copy with `make init`, then provide the required secret.
# Syntax is strict KEY=VALUE dotenv; shell expressions are not executed.

# Pinned upstream runtime. The bootstrap rejects other versions.
AGENTTEAMS_VERSION=v1.2.2
AGENTTEAMS_LANGUAGE=zh

# LLM provider. Any OpenAI-compatible endpoint can replace these defaults.
AGENTTEAMS_LLM_PROVIDER=openai-compat
AGENTTEAMS_OPENAI_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
AGENTTEAMS_DEFAULT_MODEL=qwen3.5-plus
AGENTTEAMS_LLM_API_KEY=

# Bootstrap administrator. Leave the password empty to generate it locally.
AGENTTEAMS_ADMIN_USER=admin
AGENTTEAMS_ADMIN_PASSWORD=

# Local ports. The bootstrap always binds them to 127.0.0.1.
AGENTTEAMS_PORT_GATEWAY=18080
AGENTTEAMS_PORT_CONSOLE=18001
AGENTTEAMS_PORT_ELEMENT_WEB=18088
AGENTTEAMS_PORT_MANAGER_CONSOLE=18888
AGENTTEAMS_PORT_DASHBOARD=13000

# Agent runtimes used by the current validation profile.
AGENTTEAMS_MANAGER_RUNTIME=copaw
AGENTTEAMS_DEFAULT_WORKER_RUNTIME=copaw
AGENTTEAMS_MATRIX_E2EE=0
AGENTTEAMS_WORKER_IDLE_TIMEOUT=720

# Upstream AgentTeams management dashboard.
AGENTTEAMS_DASHBOARD=1
# Optional overrides; leave unset to use the installer defaults.
# AGENTTEAMS_DASHBOARD_VERSION=
# AGENTTEAMS_DASHBOARD_IMAGE=

# Generated paths, the Docker volume name, socket mounting, and network exposure
# are intentionally fixed by scripts/agentteams.sh and are not configurable.
